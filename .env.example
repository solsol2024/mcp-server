# Required: 32-byte key for AES-256-GCM encryption of stored eshop tokens.
# Generate with: openssl rand -base64 32
MCP_TOKEN_ENCRYPTION_KEY=

# Upstash Redis (injected automatically by the Vercel Marketplace integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: public base URL used as OAuth issuer (defaults to the request origin)
# MCP_PUBLIC_URL=https://solsol-mcp.example.com

# Optional eshop settings
# SOLSOL_LOCALE=cs
# SOLSOL_SITE_URL=https://solsol.eu
# SOLSOL_GRAPHQL_URL=https://solsol.eu/graphql/
